# Local Compose credentials. Change these for any shared deployment.
GOMUSIC_MYSQL_PASSWORD=gomusic_local
GOMUSIC_MYSQL_ROOT_PASSWORD=gomusic_root_local
GOMUSIC_MYSQL_PORT=13306
GOMUSIC_REDIS_PASSWORD=gomusic_local
GOMUSIC_REDIS_PORT=16379
GOMUSIC_PORT=8081
# Set a private token to enable GET /api/v1/stats (Authorization: Bearer ...).
GOMUSIC_STATS_TOKEN=
# Set true when the public website uses HTTPS.
GOMUSIC_STATS_COOKIE_SECURE=false
# For running Go on the host, export the following (Compose sets container addresses itself):
# MYSQL_DSN=go_music:gomusic_local@tcp(127.0.0.1:13306)/go_music?charset=utf8mb4&parseTime=true&loc=UTC&timeout=3s&readTimeout=3s&writeTimeout=3s
# REDIS_ADDR=127.0.0.1:16379
# GOMUSIC_ADDR=:8081
# GOMUSIC_REQUEST_TIMEOUT=90s
# GOMUSIC_UPSTREAM_TIMEOUT=12s
# GOMUSIC_CACHE_TTL=720h
# GOMUSIC_MAX_SONGS=10000
# GOMUSIC_CONCURRENCY=4
# GOMUSIC_ALLOWED_ORIGINS=https://your-frontend.example
