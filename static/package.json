{
  "name": "gomusic-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "serve": "vite --host 127.0.0.1",
    "check": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src scripts tests *.ts *.json index.html"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
